# Copia este archivo a .env y completa los valores. Las variables VITE_* se incrustan
# en el bundle público al compilar: no pongas secretos aquí.

# Cloudinary (subida de imágenes desde el panel)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Backend al que apunta el proxy de Vite (/api y /hubs) en desarrollo
# (en Docker lo sobrescribe docker-compose.yml con http://api:5000)
VITE_API_URL=http://localhost:5000
VITE_FRONTEND_URL=http://localhost:3000

# URL completa del hub de SignalR. Vacía en desarrollo (usa el proxy de Vite).
# En producción se define en Vercel (Environment Variables → Production) y exige redeploy:
#   VITE_HUB_URL=https://floreriabautista-backend.onrender.com/hubs/venta-instantanea
VITE_HUB_URL=
